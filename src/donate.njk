---
layout: page
pagination:
  data: globals.locales
  size: 1
  alias: locale
permalink: "{{ locale }}/donate/index.html"
activePage: donate
---

<section class="container mx-auto prose prose-lg">
  <h1>{{ lang.title }}</h1>
  {% if lang.intro %}{{ lang.intro|markdown|safe }}{% endif %}
</section>
<section class="container mx-auto">
  {# FA CSP allows framing from https origins only (not local http). #}
  <iframe id="donate-form"
          title="Donate"
          class="w-full border-0"
          height="800"></iframe>
</section>
<script>
  (function () {
    const iframe = document.getElementById('donate-form');
    if (!iframe) return;

    const FA_ORIGIN = 'https://alphagiving.tfaforms.net';
    const IFRAME_ID = 'bnap-donate';
    const params = new URLSearchParams({
      faIframeUniqueId: IFRAME_ID,
      hostURL: window.location.href,
    });
    iframe.src = FA_ORIGIN + '/90?' + params.toString();

    window.addEventListener('message', function (event) {
      if (event.origin !== FA_ORIGIN) return;
      if (typeof event.data !== 'string') return;

      const parts = event.data.split(',');
      const command = parts[0];
      const id = parts[1];

      if (id && id !== 'unknown' && id !== IFRAME_ID) return;

      const height = parseInt(command, 10);
      if (!Number.isNaN(height) && height > 0) {
        const scrollTop = window.pageYOffset || document.documentElement.scrollTop;
        iframe.height = height;
        iframe.style.height = height + 'px';
        setTimeout(function () {
          document.documentElement.scrollTop = document.body.scrollTop = scrollTop;
        }, 0);
        return;
      }

      if (command === 'pagechange' || command.indexOf('pagechangeIOS_') === 0 || command === 'submitted') {
        iframe.scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    });
  })();
</script>
